{
  "$description": "Smile Genius Go design tokens. In this React Native app the source of truth is src/theme/tokens.ts (same values as the web prototype go.css).",
  "color": {
    "bg": {
      "light": "#F6F7FB",
      "dark": "#070710",
      "use": "App background"
    },
    "surface": {
      "light": "#FFFFFF",
      "dark": "#10101E",
      "use": "Cards, sheets, inputs, tab bar"
    },
    "raised": {
      "light": "#F8F9FC",
      "dark": "#171729",
      "use": "Subtle fill inside a surface (chips, icon buttons)"
    },
    "line": {
      "light": "#E0E0E6",
      "dark": "#26263A",
      "use": "Borders, dividers"
    },
    "ink": {
      "light": "#030213",
      "dark": "#F2F2FA",
      "use": "Primary text"
    },
    "ink2": {
      "light": "#5A5568",
      "dark": "#C8C8D8",
      "use": "Secondary text"
    },
    "muted": {
      "light": "#717182",
      "dark": "#9696AC",
      "use": "Tertiary text, labels, inactive tab"
    },
    "faint": {
      "light": "#A0A0B0",
      "dark": "#606078",
      "use": "Placeholders, disabled, footnotes"
    },
    "brand": {
      "light": "#4D8EF7",
      "dark": "#6BA2FF",
      "use": "Primary action, links, active state, focus ring (15%)"
    },
    "brand-ink": {
      "light": "#1565C0",
      "dark": "#96BEFF",
      "use": "Text/icon on brand-soft"
    },
    "brand-soft": {
      "light": "#EEF4FF",
      "dark": "#162240",
      "use": "Brand tint background (active tab pill, selected row)"
    },
    "lav": {
      "light": "#A59DFF",
      "dark": "#B2AAFF",
      "use": "Brand accent (logo lavender)"
    },
    "violet": {
      "light": "#7C3AED",
      "dark": "#B496FF",
      "use": "Accent tone"
    },
    "violet-soft": {
      "light": "#F5F3FF",
      "dark": "#211A40",
      "use": "Accent tint"
    },
    "ok": {
      "light": "#15803D",
      "dark": "#4ADE80",
      "use": "Success / in practice / received"
    },
    "ok-soft": {
      "light": "#F0FDF4",
      "dark": "#0E2A1C",
      "use": "Success tint"
    },
    "warn": {
      "light": "#B45309",
      "dark": "#FBBF24",
      "use": "Warning / attention / on hold"
    },
    "warn-soft": {
      "light": "#FFF7ED",
      "dark": "#30220A",
      "use": "Warning tint"
    },
    "bad": {
      "light": "#D4183D",
      "dark": "#FB7185",
      "use": "Error / overdue / at risk"
    },
    "bad-soft": {
      "light": "#FFF1F2",
      "dark": "#36101C",
      "use": "Error tint"
    },
    "teal": {
      "light": "#00838F",
      "dark": "#2DD4BF",
      "use": "Info accent"
    },
    "teal-soft": {
      "light": "#E0F7FA",
      "dark": "#0A2A2C",
      "use": "Info tint"
    },
    "pink": {
      "light": "#BE185D",
      "dark": "#F472B6",
      "use": "Accent tone"
    },
    "pink-soft": {
      "light": "#FDF2F8",
      "dark": "#361228",
      "use": "Accent tint"
    },
    "shadow": {
      "light": "#101840",
      "dark": "#000000",
      "use": "Shadow colour (used at 4-12% alpha)"
    },
    "g1": {
      "light": "#4D8EF7",
      "dark": "#4278EC",
      "use": "Gradient start (logo smile)"
    },
    "g2": {
      "light": "#A59DFF",
      "dark": "#8070F0",
      "use": "Gradient end (logo smile)"
    }
  },
  "gradient": {
    "brand": "linear-gradient(135deg, g1, g2) - FAB, primary hero, logo",
    "brandText": "linear-gradient(90deg, brand, lav) - the word \"Go\"",
    "appBackground": "go-bg + radial lav/26% and brand/12% rising from the bottom centre (around the + button) + lav/7% bottom fade (.go-wash), on every screen"
  },
  "font": {
    "family": "Poppins (Google Fonts, 300-700)",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "size": {
      "micro": "10-10.5px - badges, tab labels",
      "caption": "11-11.5px - meta, hints; section eyebrows are 11px bold uppercase, tracking 0.14em",
      "small": "12-12.5px - secondary lines",
      "body": "13-13.5px - list rows, labels",
      "bodyLarge": "14-15px - inputs, buttons, primary row text",
      "title": "19-20px bold - sheet and screen titles",
      "display": "22px+ bold - large top bar, hero numbers"
    }
  },
  "radius": {
    "sm": "8px",
    "md": "12px - md buttons, dense controls",
    "lg": "16px - buttons, inputs, tiles",
    "card": "22px",
    "tabBar": "26px",
    "sheet": "30px (top corners)",
    "pill": "9999px"
  },
  "size": {
    "buttonLg": "52px tall, 15px semibold, radius 16",
    "buttonMd": "40px tall, 13.5px semibold, radius 12",
    "iconButton": "36-40px",
    "tabBar": "64px, floating, 12px side inset, surface/80 + blur",
    "fab": "56px, radius 20, gradient + glow, sits 28px above the bar",
    "touchTargetMin": "40px",
    "screenGutter": "20px",
    "designFrame": "390 x 844 (iPhone 14/15)"
  },
  "shadow": {
    "card": "0 1px 2px shadow/4%, 0 8px 24px -12px shadow/12%",
    "glow": "0 10px 30px -8px g1/55%",
    "sheetScrim": "black/45 + 2px blur"
  },
  "motion": {
    "easing": "cubic-bezier(.2,.8,.2,1)",
    "sheetIn": "280ms slide up",
    "fade": "200ms",
    "toast": "250ms, auto-dismiss 3.2s",
    "rise": "350ms, 8px",
    "press": "scale .98 buttons, .99 cards"
  }
}
